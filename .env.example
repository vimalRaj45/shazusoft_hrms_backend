PORT=5000
JWT_SECRET=super_secret_shazusoft_jwt_key_2026

# Google Sheets Configuration
# Path to your Google Cloud Service Account JSON file (relative to backend folder or absolute path)
GOOGLE_SERVICE_ACCOUNT_FILE=./service.json
# Google Spreadsheet ID (from your spreadsheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Office Geofence Settings (Target Office GPS Coordinates)
OFFICE_LATITUDE=12.971598
OFFICE_LONGITUDE=77.594566
OFFICE_RADIUS_METERS=150

# Mistral AI API Key (from https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
